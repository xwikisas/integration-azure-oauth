      <code>#set ($propertiesEditorDoc = $xwiki.getDocument('EntraID.Code.PropertiesEditor'))
require.config({
  paths: {
    'entraid-properties-editor':
      "$propertiesEditorDoc.getURL('jsx', "v=$escapetool.url($propertiesEditorDoc.version)")"
  }
});
require(['jquery', 'entraid-properties-editor'], function($, propertiesEditor) {
  // The configuration comes from the "entraid-propertize" data of the property, set in the layout of the template.
  $('.oidcpro-property').each(function() {
    const config = $(this).data('entraidPropertize');
    if (config) {
      propertiesEditor.propertize($(this).find('textarea').first(), config);
    }
  });
});</code>
