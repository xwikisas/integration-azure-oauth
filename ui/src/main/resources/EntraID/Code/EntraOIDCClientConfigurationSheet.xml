require(['jquery', 'entraid-properties-editor', 'xwiki-selectize'], function($, propertiesEditor) {
  $(function() {
    const getPropertyInput = function(propertyName) {
      return $(document.getElementById('XWiki.OIDC.ClientConfigurationClass_0_' + propertyName));
