/**
 * Edit the map properties of an Entra ID client configuration (e.g. the groups mapping) with xwikiPropertize.
 * Load it with the path set by EntraID.Code.PropertiesEditor#require.config and use the stylesheet of this page.
 */
define('entraid-properties-editor', ['jquery', 'xwiki-l10n!entraid-properties-editor-translation-keys',
    'xwiki-propertize', 'xwiki-suggestGroups'], function($, l10n) {
  const suggestGroups = function(propertiesElement) {
    // The suggest picker marks the inputs it enhances as selectized.
    propertiesElement.find('input.key').not('.selectized').suggestGroups({userScope: 'LOCAL_ONLY'});
  };

  return {
    /**
     * @param textarea the textarea holding the property value, displayed only in edit mode
     * @param config the separator of the entries, the translation keys (relative to "entra.properties.data.") of
     *     the key and value tips, and whether to suggest XWiki groups for the keys
     */
    propertize: function(textarea, config) {
      if (textarea.length === 0) {
        return;
      }
      textarea.xwikiPropertize({
        separator: config.separator,
        keyTip: l10n.get(config.keyTip),
        valueTip: l10n.get(config.valueTip),
        addproperty: {
          label: l10n.get('newEntry')
        }
      });
      if (config.suggestGroups) {
        const propertiesElement = textarea[0].xwikiPropertize.element;
        suggestGroups(propertiesElement);
        // This handler is bound after the one adding the property, so the new key input already exists.
        propertiesElement.parent().find('.addProperty').on('click', () =&gt; suggestGroups(propertiesElement));
      }
    }
  };
});</code>
